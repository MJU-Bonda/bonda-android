        android:label="도서"
        tools:layout="@layout/fragment_books" />

    <fragment
        android:id="@+id/navigation_library"
        android:name="com.bonda.bonda.ui.library.LibraryFragment"
        android:label="서재"
        tools:layout="@layout/fragment_library" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.bonda.bonda.ui.profile.ProfileFragment"
