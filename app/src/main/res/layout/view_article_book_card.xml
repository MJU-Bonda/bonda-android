<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="32sp"
    android:background="@color/article_book_card_background"
    tools:context=".ui.article.ArticleActivity">

    <TextView
        android:id="@+id/book_card_index"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="01 / 04"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16sp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="128sp"
            android:layout_height="128sp"
            app:cardBackgroundColor="@color/article_background">

            <ImageView
                android:id="@+id/book_card_preview_image"
                android:layout_width="128sp"
                android:layout_height="128sp"
                android:src="@drawable/dummy_book3" />
        </com.google.android.material.card.MaterialCardView>

        <!--        책 정보가 표시됩니다         -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginLeft="8sp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/book_card_chip_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include layout="@layout/view_chip_theme" />
                <include layout="@layout/view_chip_publisher" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/book_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="하트책"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/book_card_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이혜승"
                android:textSize="16sp"
                android:layout_marginTop="8sp" />
        </LinearLayout>


    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="32dp"
        android:background="?attr/colorOutline"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/book_card_body"
        android:textSize="16sp" />

    <Button
        android:id="@+id/button_get_book_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32sp"
        android:text="도서 정보 확인하기" />

</LinearLayout>