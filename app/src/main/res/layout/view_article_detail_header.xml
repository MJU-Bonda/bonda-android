    <!--        android:layout_width="wrap_content"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:text="뒤로가기"-->
    <!--        android:layout_margin="16dp"-->
    <!--        app:layout_constraintTop_toTopOf="@id/article_image"-->
    <!--        app:layout_constraintLeft_toLeftOf="@id/article_image"/>-->

    <!--    <com.google.android.material.button.MaterialButton-->
    <!--        android:id="@+id/article_button_save"-->
    <!--        android:layout_width="wrap_content"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:text="저장"-->
    <!--        android:layout_margin="16dp"-->
    <!--        app:layout_constraintTop_toTopOf="@id/article_image"-->
    <!--        app:layout_constraintRight_toRightOf="@id/article_image"/>-->

    <TextView
        android:id="@+id/article_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16sp"
        android:text="@string/article_view_title"
        android:textColor="@color/white"
        android:textSize="32sp"
        app:layout_constraintBottom_toTopOf="@id/article_subtitle"
        app:layout_constraintLeft_toLeftOf="@id/article_image"/>

    <TextView
        android:id="@+id/article_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginVertical="32sp"
        android:text="@string/article_view_subtitle"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/article_image"
        app:layout_constraintLeft_toLeftOf="@id/article_image"/>

</androidx.constraintlayout.widget.ConstraintLayout>